# Local: SITE_ADDRESS defaults to :80 (plain HTTP). Staging/production set a real domain so Caddy gets HTTPS itself.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@api path /api/* /healthz
	handle @api {
		reverse_proxy api:3001 {
			# Override the client-sent id; the API uses it for logs and the response header.
			header_up X-Request-Id {http.request.uuid}
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
