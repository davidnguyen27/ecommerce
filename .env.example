# Copy to .env to override docker-compose.yml defaults.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
LOG_LEVEL=info
# JWT signing key, at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
SITE_ADDRESS=:80
# Base URL for links sent by email (verification links). Defaults to http://localhost:<HTTP_PORT>.
SITE_URL=
# log: only log emails (local). resend: really send, needs RESEND_API_KEY and MAIL_FROM.
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM=
# memory: keep files in memory (local, images not viewable). r2: Cloudflare R2 via the S3 API, needs the R2_* vars and
# MEDIA_PUBLIC_URL.
# To view images locally: COMPOSE_PROFILES=local (enables SeaweedFS in docker-compose.yml), STORAGE_PROVIDER=r2,
# R2_ENDPOINT=http://s3.localhost:9000, R2_ACCESS_KEY_ID=local-access-key, R2_SECRET_ACCESS_KEY=local-secret-key,
# R2_PUBLIC_BUCKET=media-public, R2_PRIVATE_BUCKET=media-private, MEDIA_PUBLIC_URL=http://s3.localhost:9000/media-public
STORAGE_PROVIDER=memory
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket (images, logos, behind a CDN custom domain) and private bucket (documents, signed URLs only).
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
# CDN base URL of the public bucket, e.g. https://cdn.shop.vn
MEDIA_PUBLIC_URL=
# VNPAY payments (ADR 0010), sandbox only for now, no real money. Guide: docs/vnpay.md
# Leave both keys empty to use the simulator. To try sandbox: register at https://pay.vnpaytest.vn/dev-registration,
# VNPAY emails vnp_TmnCode and vnp_HashSecret; set both. Never commit any key, sandbox keys included.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# sandbox (default) or production. Real money needs a VNPAY contract and an explicit production.
VNPAY_ENV=sandbox
# Server IP sent when the API queries VNPAY (vnp_IpAddr); empty means 127.0.0.1.
VNPAY_SERVER_IP=
# allow: permits the simulator or VNPAY sandbox although the API image runs NODE_ENV=production; local docker compose
# needs this line. Production: remove it; missing or sandbox keys then stop the API instead of taking unpaid orders.
PAYMENT_SIMULATOR=allow

# Chatbot (M8, ADR 0017): free-tier keys, no cost. Groq: https://console.groq.com/keys. OpenRouter:
# https://openrouter.ai/settings/keys, and allow providers to store prompts in settings/privacy or :free models fail.
# Leave both empty and the chatbot turns off; with one key missing, the chain drops that provider's models.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# The model chain in order, as provider:model, comma-separated. Empty is the default chain
# (groq gpt-oss-120b → groq qwen3.8-27b → openrouter nemotron-3-ultra). fake: fake model for E2E, no network.
# Recheck quality after a change: pnpm chatbot-check
LLM_CHAIN=
