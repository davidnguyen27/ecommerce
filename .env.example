# Sao chép thành .env để ghi đè giá trị mặc định của docker-compose.yml.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
LOG_LEVEL=info
# Khóa ký JWT, ít nhất 32 ký tự. Tạo bằng: openssl rand -base64 48
JWT_SECRET=
SITE_ADDRESS=:80
# Gốc URL trong link gửi qua email (link xác minh). Mặc định http://localhost:<HTTP_PORT>.
SITE_URL=
# log: chỉ ghi email ra log (local). resend: gửi thật, cần RESEND_API_KEY và MAIL_FROM.
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM=
# memory: giữ file trong bộ nhớ (local, ảnh không xem được). r2: Cloudflare R2 qua API S3, cần các biến R2_* và MEDIA_PUBLIC_URL.
# Local xem được ảnh: COMPOSE_PROFILES=local (bật SeaweedFS trong docker-compose.yml), STORAGE_PROVIDER=r2,
# R2_ENDPOINT=http://s3.localhost:9000, R2_ACCESS_KEY_ID=local-access-key, R2_SECRET_ACCESS_KEY=local-secret-key,
# R2_PUBLIC_BUCKET=media-public, R2_PRIVATE_BUCKET=media-private, MEDIA_PUBLIC_URL=http://s3.localhost:9000/media-public
STORAGE_PROVIDER=memory
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket public (ảnh, logo, gắn custom domain CDN) và bucket private (chứng từ, chỉ mở qua URL ký).
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
# Gốc URL CDN của bucket public, ví dụ https://cdn.shop.vn
MEDIA_PUBLIC_URL=
# Thanh toán ZaloPay (ADR 0009), hiện chỉ chạy sandbox, không có tiền thật. Hướng dẫn: docs/zalopay.md
# Để trống cả ba khóa thì dùng cổng giả lập. Thử sandbox: lấy App ID, Key1, Key2 của app sandbox ở https://sbmc.zalopay.vn
# rồi đặt đủ cả ba. Không commit khóa nào, kể cả khóa sandbox.
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
# sandbox (mặc định) hoặc production. Tiền thật cần khóa ở https://mc.zalopay.vn và đặt rõ production.
ZALOPAY_ENV=sandbox
# URL ZaloPay gọi khi tiền về. Thử trên máy thì đặt URL tunnel: https://<tunnel>/api/payments/zalopay/callback.
# Để trống thì dùng SITE_URL + /api/payments/zalopay/callback.
ZALOPAY_CALLBACK_URL=
# allow: cho cổng giả lập hay ZaloPay sandbox dù image API chạy NODE_ENV=production; docker compose local cần dòng này.
# Production: xóa dòng này; thiếu khóa hay dùng khóa sandbox thì API dừng khởi động thay vì nhận đơn không có tiền thật.
PAYMENT_SIMULATOR=allow
