generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Auth domain, also the JWT audience (ADR 0001).
enum AuthAudience {
  staff
  customer

  @@map("auth_audience")
}

/// Fixed roles; each role's permission set is defined in code.
enum StaffRole {
  owner
  sales
  warehouse
  accountant

  @@map("staff_role")
}

/// Staff. No sign-up; the first owner is created by the seed command.
model Staff {
  id           String      @id @default(uuid()) @db.Uuid
  /// Always stored lowercase.
  email        String      @unique
  name         String
  /// argon2id, PHC string format.
  passwordHash String      @map("password_hash")
  roles        StaffRole[] @default([])
  /// Set means the account is locked.
  lockedAt     DateTime?   @map("locked_at")
  /// Reserved for 2FA (TOTP), not enabled.
  totpSecret   String?     @map("totp_secret")
  totpEnabled  Boolean     @default(false) @map("totp_enabled")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  auditLogs                AuditLog[]
  publishedVersions        ContentPageVersion[]
  publishedProductVersions ProductVersion[]
  stockMovements           StockMovement[]
  stockReceipts            StockReceipt[]
  orderEvents              OrderEvent[]
  resolvedReconciliations  ReconciliationItem[]
  createdRefunds           Refund[]             @relation("RefundCreatedBy")
  executedRefunds          Refund[]             @relation("RefundExecutedBy")
  settledRefunds           Refund[]             @relation("RefundSettledBy")
  assignedSupportRequests  SupportRequest[]     @relation("SupportAssignee")
  createdSupportRequests   SupportRequest[]     @relation("SupportCreatedBy")
  supportMessages          SupportMessage[]
  decidedSupportRequests   SupportRequest[]     @relation("SupportDecidedBy")
  receivedSupportRequests  SupportRequest[]     @relation("SupportReceivedBy")
  preorderCampaigns        PreorderCampaign[]
  vouchers                 Voucher[]

  @@map("staff")
}

/// Append-only: migration triggers block UPDATE, DELETE and TRUNCATE.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// Write order, for stable sorting when entries share a timestamp.
  seq        BigInt   @unique @default(autoincrement())
  actorId    String   @map("actor_id") @db.Uuid
  actor      Staff    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// E.g. `staff.create`, `staff.roles.change`.
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, createdAt])
  @@map("audit_log")
}

/// Fixed-window rate limit counter. `key` is the SHA-256 of the limit name with the IP or email.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime @map("window_start")
  hits        Int

  @@map("rate_limit_bucket")
}

/// Refresh tokens of every domain. Hash only; tokens from one sign-in share a family.
model RefreshToken {
  id        String       @id @default(uuid()) @db.Uuid
  audience  AuthAudience
  subjectId String       @map("subject_id") @db.Uuid
  familyId  String       @map("family_id") @db.Uuid
  /// SHA-256 of the token, hex.
  tokenHash String       @unique @map("token_hash")
  /// Absolute session expiry: rotated tokens inherit the old token's expiry.
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  revokedAt DateTime?    @map("revoked_at")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([audience, subjectId])
  @@index([familyId])
  @@map("refresh_token")
}

/// Self-registered customers; fully apart from `staff` (ADR 0001), so an email may match a staff member's.
model Customer {
  id                  String    @id @default(uuid()) @db.Uuid
  /// Always stored lowercase.
  email               String    @unique
  /// argon2id, PHC string format.
  passwordHash        String    @map("password_hash")
  /// Unverified does not block using the account.
  emailVerifiedAt     DateTime? @map("email_verified_at")
  /// Shipping address (`ShippingAddress`) of the latest successful checkout; prefilled on checkout.
  lastShippingAddress Json?     @map("last_shipping_address")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  consents        CustomerConsent[]
  tokens          CustomerToken[]
  orders          Order[]
  orderEvents     OrderEvent[]
  supportRequests SupportRequest[]

  @@map("customer")
}

/// Append-only: which exact privacy policy version the customer agreed to, and when.
model CustomerConsent {
  id              String             @id @default(uuid()) @db.Uuid
  customerId      String             @map("customer_id") @db.Uuid
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  policyVersionId String             @map("policy_version_id") @db.Uuid
  policyVersion   ContentPageVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  consentedAt     DateTime           @default(now()) @map("consented_at")

  @@index([customerId])
  @@map("customer_consent")
}

/// Purpose of a one-time emailed token. Ticket 06 added password reset.
enum CustomerTokenPurpose {
  email_verification
  password_reset

  @@map("customer_token_purpose")
}

/// One-time, expiring token sent by email. Hash only.
model CustomerToken {
  id         String               @id @default(uuid()) @db.Uuid
  customerId String               @map("customer_id") @db.Uuid
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  purpose    CustomerTokenPurpose
  /// SHA-256 of the token, hex.
  tokenHash  String               @unique @map("token_hash")
  expiresAt  DateTime             @map("expires_at")
  usedAt     DateTime?            @map("used_at")
  createdAt  DateTime             @default(now()) @map("created_at")

  @@index([customerId, purpose])
  @@map("customer_token")
}

enum ContentPageKind {
  about
  process
  policy

  @@map("content_page_kind")
}

/// Content page. `title`, `body` are the draft; customers only see the latest published version.
model ContentPage {
  id        String          @id @default(uuid()) @db.Uuid
  /// Fixed after creation, since public URLs and other modules reference the slug.
  slug      String          @unique
  kind      ContentPageKind
  title     String
  /// Markdown.
  body      String
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  versions ContentPageVersion[]
  products ProductPolicyPage[]

  @@map("content_page")
}

/// Page content at one publish; never edited or deleted, so consents and orders reference the content as it was.
model ContentPageVersion {
  id            String      @id @default(uuid()) @db.Uuid
  pageId        String      @map("page_id") @db.Uuid
  page          ContentPage @relation(fields: [pageId], references: [id], onDelete: Restrict)
  /// Numbered from 1 per page.
  version       Int
  title         String
  body          String
  publishedAt   DateTime    @default(now()) @map("published_at")
  publishedById String      @map("published_by_id") @db.Uuid
  publishedBy   Staff       @relation(fields: [publishedById], references: [id], onDelete: Restrict)

  customerConsents CustomerConsent[]
  orders           OrderPolicyVersion[]
  orderConsents    Order[]

  @@unique([pageId, version])
  @@map("content_page_version")
}

/// The five fixed product types, roots of the category tree; they decide a product's attribute schema.
enum ProductType {
  footwear
  apparel
  watch
  bag
  fragrance

  @@map("product_type")
}

/// Brand. Hiding only removes it from public lists and its own page; products are unaffected.
model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String   @default("")
  hidden      Boolean  @default(false)
  /// Logo in the public bucket: `StoredImage` (api/src/media/images.ts), `null` when none.
  logo        Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products        Product[]
  productVersions ProductVersion[]
  vouchers        VoucherBrand[]

  @@map("brand")
}

/// Attribute schema of one product type; every category in the type shares it.
model AttributeSchema {
  productType ProductType @id @map("product_type")
  /// Array of `AttributeDefinition` (@ecommerce/shared), in display order.
  attributes  Json
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at")

  @@map("attribute_schema")
}

/// A category tree node, entirely within one product type (ADR 0004). Null `parentId` is a direct child of the type.
model Category {
  id          String      @id @default(uuid()) @db.Uuid
  /// Fixed at creation; children always share the parent's product type.
  productType ProductType @map("product_type")
  parentId    String?     @map("parent_id") @db.Uuid
  parent      Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]  @relation("CategoryTree")
  slug        String      @unique
  name        String
  /// Hiding a category also drops its whole subtree from the menu.
  hidden      Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  products        Product[]
  productVersions ProductVersion[]
  vouchers        VoucherCategory[]

  @@index([parentId])
  @@map("category")
}

/// Product lifecycle; only `published` shows to customers, who only read the published version.
enum ProductStatus {
  draft
  published
  archived

  @@map("product_status")
}

enum VariantStatus {
  active
  discontinued

  @@map("variant_status")
}

/// Product: one model of one brand. No warranty field (ADR 0005).
model Product {
  id                 String          @id @default(uuid()) @db.Uuid
  /// Taken from the category at creation and fixed; category changes stay within the type.
  productType        ProductType     @map("product_type")
  brandId            String          @map("brand_id") @db.Uuid
  brand              Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId         String          @map("category_id") @db.Uuid
  category           Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug               String          @unique
  name               String
  /// The brand's model code; empty string when unknown.
  modelCode          String          @default("") @map("model_code")
  description        String          @default("")
  /// Usage and care instructions.
  usageCare          String          @default("") @map("usage_care")
  /// `SizeChart` (@ecommerce/shared), `null` when none.
  sizeChart          Json?           @map("size_chart")
  /// Published origin statement, without evidence.
  originStatement    String          @default("") @map("origin_statement")
  /// Product-level attributes, validated against the product type schema.
  attributes         Json            @default("{}")
  groundShippingOnly Boolean         @default(false) @map("ground_shipping_only")
  status             ProductStatus   @default(draft)
  /// The version customers see; check constraint: set exactly when `status = published`.
  liveVersionId      String?         @unique @map("live_version_id") @db.Uuid
  liveVersion        ProductVersion? @relation("LiveVersion", fields: [liveVersionId], references: [id], onDelete: Restrict)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  variants          ProductVariant[]
  images            ProductImage[]
  versions          ProductVersion[]    @relation("ProductVersions")
  policyPages       ProductPolicyPage[]
  documents         ProductDocument[]
  commitments       ProductCommitment[]
  search            ProductSearch?
  preorderCampaigns PreorderCampaign[]

  @@index([productType])
  @@index([brandId])
  @@index([categoryId])
  @@map("product")
}

/// The variant customers buy. The migration has a unique index `(product_id, attributes)` Prisma cannot declare on
/// Json.
model ProductVariant {
  id             String        @id @default(uuid()) @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Unique system-wide, stored uppercase.
  sku            String        @unique
  /// Variant-level attributes, validated against the product type schema.
  attributes     Json          @default("{}")
  /// VND including VAT; `null` when unpriced. Check constraint: `> 0`, compare-at price `>=` sale price.
  price          BigInt?
  compareAtPrice BigInt?       @map("compare_at_price")
  status         VariantStatus @default(active)
  sortOrder      Int           @default(0) @map("sort_order")
  /// Stock on hand; check constraint `>= 0`. Written only by the stock module (api/src/stock/stock.ts), with a ledger
  /// row.
  onHand         Int           @default(0) @map("on_hand")
  /// Reserved for orders (ADR 0007); check constraints `>= 0` and `<= on_hand`. In stock when `on_hand - reserved > 0`.
  reserved       Int           @default(0)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  images               ProductImageVariant[]
  stockMovements       StockMovement[]
  orderLines           OrderLine[]
  preorderCampaigns    PreorderCampaignVariant[]
  supportReceivedLines SupportRequestLine[]      @relation("SupportLineReceived")
  supportHeldLines     SupportRequestLine[]      @relation("SupportLineHeld")
  supportExchangeLines SupportRequestLine[]      @relation("SupportLineExchange")

  @@map("product_variant")
}

enum StockMovementKind {
  receipt
  adjustment
  opening
  /// Sale: an order's goods leave stock at handover (ADR 0007).
  sale
  /// Goods of a failed delivery received back and restocked (M6a); points at the order like a sale.
  return

  @@map("stock_movement_kind")
}

enum StockAdjustmentReason {
  stocktake
  damaged
  lost
  other

  @@map("stock_adjustment_reason")
}

/// Stock ledger. Append-only: migration triggers block UPDATE, DELETE and TRUNCATE.
model StockMovement {
  id               String                 @id @default(uuid()) @db.Uuid
  /// Write order, for stable sorting when rows share a timestamp.
  seq              BigInt                 @unique @default(autoincrement())
  variantId        String                 @map("variant_id") @db.Uuid
  variant          ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  kind             StockMovementKind
  /// Signed: positive increases, negative decreases; non-zero.
  quantity         Int
  onHandAfter      Int                    @map("on_hand_after")
  /// Only on adjustments (check constraint).
  reason           StockAdjustmentReason?
  note             String                 @default("")
  /// Present on, and only on, receipt rows (check constraint).
  receiptId        String?                @map("receipt_id") @db.Uuid
  receipt          StockReceipt?          @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  /// Present on, and only on, sale rows (check constraint).
  orderId          String?                @map("order_id") @db.Uuid
  order            Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Returned goods (or exchange goods sent) of a support request (M6b); only with kind `return` or `sale`.
  supportRequestId String?                @map("support_request_id") @db.Uuid
  supportRequest   SupportRequest?        @relation(fields: [supportRequestId], references: [id], onDelete: Restrict)
  actorId          String                 @map("actor_id") @db.Uuid
  actor            Staff                  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt        DateTime               @default(now()) @map("created_at")

  @@index([variantId, seq])
  @@index([createdAt])
  @@index([receiptId])
  @@index([orderId])
  @@index([supportRequestId])
  @@map("stock_movement")
}

/// Stock receipt; its lines are `StockMovement` rows of kind `receipt`. Append-only: triggers block UPDATE, DELETE,
/// TRUNCATE.
model StockReceipt {
  id           String          @id @default(uuid()) @db.Uuid
  seq          BigInt          @unique @default(autoincrement())
  /// Free text; M2 has no supplier directory.
  supplierName String          @map("supplier_name")
  receivedOn   DateTime        @map("received_on") @db.Date
  note         String          @default("")
  createdById  String          @map("created_by_id") @db.Uuid
  createdBy    Staff           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime        @default(now()) @map("created_at")
  movements    StockMovement[]

  @@map("stock_receipt")
}

/// Product content at one publish; customers read only this. Never edited or deleted (migration trigger).
/// Columns besides `snapshot` are copies from it for filtering and sorting.
model ProductVersion {
  id                 String      @id @default(uuid()) @db.Uuid
  productId          String      @map("product_id") @db.Uuid
  product            Product     @relation("ProductVersions", fields: [productId], references: [id], onDelete: Restrict)
  /// Numbered from 1 per product.
  version            Int
  slug               String
  productType        ProductType @map("product_type")
  brandId            String      @map("brand_id") @db.Uuid
  brand              Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId         String      @map("category_id") @db.Uuid
  category           Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Lowest price among variants on sale, and that variant's compare-at price.
  fromPrice          BigInt      @map("from_price")
  fromCompareAtPrice BigInt?     @map("from_compare_at_price")
  /// `ProductSnapshot` (api/src/catalog/publication.ts).
  snapshot           Json
  publishedAt        DateTime    @default(now()) @map("published_at")
  publishedById      String      @map("published_by_id") @db.Uuid
  publishedBy        Staff       @relation(fields: [publishedById], references: [id], onDelete: Restrict)

  liveOf   Product?       @relation("LiveVersion")
  searchOf ProductSearch?

  @@unique([productId, version])
  @@index([slug])
  @@index([brandId])
  @@index([categoryId])
  @@map("product_version")
}

/// Search data of products visible to customers, built from the published version and the brand name.
/// Only migration triggers write this table; search queries are raw SQL (api/src/catalog/search.ts).
model ProductSearch {
  productId String                  @id @map("product_id") @db.Uuid
  product   Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  versionId String                  @unique @map("version_id") @db.Uuid
  version   ProductVersion          @relation(fields: [versionId], references: [id], onDelete: Restrict)
  /// Product name, brand name, model code, without diacritics, lowercase.
  document  String
  tsv       Unsupported("tsvector")
  /// SKUs on sale, separated and surrounded by spaces.
  skus      String

  @@index([tsv], type: Gin)
  @@index([document(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([skus(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("product_search")
}

/// Policy pages applying to the product; linked to the page, not a version (GLOSSARY "Trang chính sách").
model ProductPolicyPage {
  productId String      @map("product_id") @db.Uuid
  product   Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  pageId    String      @map("page_id") @db.Uuid
  page      ContentPage @relation(fields: [pageId], references: [id], onDelete: Restrict)

  @@id([productId, pageId])
  @@index([pageId])
  @@map("product_policy_page")
}

/// Product image in the public bucket: original `<storageKey>/original.<ext>` and webp widths
/// `<storageKey>/w<width>.webp`.
model ProductImage {
  id          String                @id @default(uuid()) @db.Uuid
  productId   String                @map("product_id") @db.Uuid
  product     Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  storageKey  String                @unique @map("storage_key")
  /// The original's real MIME type, read from content.
  contentType String                @map("content_type")
  /// Original dimensions after EXIF rotation.
  width       Int
  height      Int
  /// Generated webp widths, by nominal width.
  widths      Int[]
  alt         String                @default("")
  sortOrder   Int                   @default(0) @map("sort_order")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  variants    ProductImageVariant[]

  @@index([productId])
  @@map("product_image")
}

/// Image linked to a variant; the API only allows variants of the image's own product.
model ProductImageVariant {
  imageId   String         @map("image_id") @db.Uuid
  image     ProductImage   @relation(fields: [imageId], references: [id], onDelete: Cascade)
  variantId String         @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([imageId, variantId])
  @@index([variantId])
  @@map("product_image_variant")
}

/// Internal supplier document in the private bucket, key `products/<productId>/documents/<id>`. Never public.
model ProductDocument {
  id          String                      @id @default(uuid()) @db.Uuid
  productId   String                      @map("product_id") @db.Uuid
  product     Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  storageKey  String                      @unique @map("storage_key")
  /// File name at upload, only so staff can recognize the document.
  fileName    String                      @map("file_name")
  /// Real MIME type, read from content.
  contentType String                      @map("content_type")
  sizeBytes   Int                         @map("size_bytes")
  createdAt   DateTime                    @default(now()) @map("created_at")
  commitments ProductCommitmentDocument[]

  @@index([productId])
  @@map("product_document")
}

enum CommitmentKind {
  warranty
  other

  @@map("commitment_kind")
}

/// Commitment type: a closed list seeded in a migration; only `commitment.edit` adds and edits.
model CommitmentType {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String              @unique
  /// `warranty` is warranty; warranty reaches customers only through this type (ADR 0005).
  kind        CommitmentKind
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at")
  commitments ProductCommitment[]

  @@map("commitment_type")
}

/// A product-level evidenced commitment; at most one per type per product.
model ProductCommitment {
  id        String                      @id @default(uuid()) @db.Uuid
  productId String                      @map("product_id") @db.Uuid
  product   Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  typeId    String                      @map("type_id") @db.Uuid
  type      CommitmentType              @relation(fields: [typeId], references: [id], onDelete: Restrict)
  /// Text shown to customers.
  statement String
  createdAt DateTime                    @default(now()) @map("created_at")
  updatedAt DateTime                    @updatedAt @map("updated_at")
  documents ProductCommitmentDocument[]

  @@unique([productId, typeId])
  @@map("product_commitment")
}

/// Documents evidencing the commitment; a referenced document cannot be deleted.
model ProductCommitmentDocument {
  commitmentId String            @map("commitment_id") @db.Uuid
  commitment   ProductCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  documentId   String            @map("document_id") @db.Uuid
  document     ProductDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([commitmentId, documentId])
  @@index([documentId])
  @@map("product_commitment_document")
}

/// System config as key → JSON value; each key's schema is defined in `@ecommerce/shared`.
model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

/// Shared shipping config, at most one row (check `id`). No row means no default fee: no orders yet.
model ShippingFeeSetting {
  id                    Boolean  @id @default(true)
  /// VND, `>= 0`.
  defaultFee            Int      @map("default_fee")
  /// Goods total at or above this ships free; `null` means no free shipping. VND, `>= 0`.
  freeShippingThreshold Int?     @map("free_shipping_threshold")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("shipping_fee_setting")
}

/// A province's own shipping fee, beating the default.
model ShippingFeeProvince {
  /// Province code per the administrative list in `@ecommerce/shared`.
  provinceCode String @id @map("province_code")
  /// VND, `>= 0`.
  fee          Int

  @@map("shipping_fee_province")
}

/// Order status (GLOSSARY "Trạng thái đơn hàng"); moves only along the spec's edges.
enum OrderStatus {
  pending_payment
  processing
  completed
  cancelled

  @@map("order_status")
}

enum PaymentStatus {
  unpaid
  /// A pre-order with its deposit paid and the remainder unpaid (M4); in-stock orders never have it.
  deposit_paid
  paid

  @@map("payment_status")
}

enum FulfillmentStatus {
  not_prepared
  preparing
  handed_over
  delivered
  failed
  /// The warehouse received goods back after a failed delivery (M6a); the order can be cancelled or redelivered from
  /// stock.
  returned

  @@map("fulfillment_status")
}

/// Why an unpaid order was cancelled: reservation expired, customer cancelled or staff cancelled.
enum OrderCancelReason {
  expired
  customer
  staff

  @@map("order_cancel_reason")
}

/// Why staff cancelled a paid order (M6a); unpaid orders have none.
enum OrderCancelCause {
  changed_mind
  remainder_overdue
  supply_failed
  delivery_failed
  other

  @@map("order_cancel_cause")
}

/// In-stock order (via the cart) or pre-order (GLOSSARY "Đơn đặt trước", ADR 0012).
enum OrderKind {
  standard
  preorder

  @@map("order_kind")
}

/// Who caused an order event: staff (with `staffId`), customer or system (expiry job, payment gateway).
enum OrderEventActor {
  staff
  customer
  system

  @@map("order_event_actor")
}

/// Order. Shipping info, money and lines are a snapshot from checkout, never changed afterwards.
model Order {
  id                String             @id @default(uuid()) @db.Uuid
  /// The code customers see and the `orderCode` sent to the gateway; its own sequence starting at 100000.
  code              Int                @unique @default(dbgenerated("nextval('order_code_seq'::regclass)"))
  status            OrderStatus        @default(pending_payment)
  paymentStatus     PaymentStatus      @default(unpaid) @map("payment_status")
  fulfillmentStatus FulfillmentStatus  @default(not_prepared) @map("fulfillment_status")
  /// Set when the customer was signed in at checkout, or a guest order linked after email verification.
  customerId        String?            @map("customer_id") @db.Uuid
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  recipientName     String             @map("recipient_name")
  phone             String
  /// Always stored lowercase.
  email             String
  provinceCode      String             @map("province_code")
  provinceName      String             @map("province_name")
  wardCode          String             @map("ward_code")
  wardName          String             @map("ward_name")
  /// House number and street.
  streetAddress     String             @map("street_address")
  note              String             @default("")
  /// VND. Check constraint: `total = subtotal - discount + shipping_fee`.
  subtotal          BigInt
  shippingFee       BigInt             @map("shipping_fee")
  total             BigInt
  /// SHA-256 of the lookup token, hex; the token only appears in the checkout response and links sent to the customer.
  lookupTokenHash   String             @unique @map("lookup_token_hash")
  /// Reservation deadline while unpaid; `null` when none (paid or cancelled).
  reservedUntil     DateTime?          @map("reserved_until")
  /// Present if and only if the order is `cancelled` (check constraint `order_cancellation_check`).
  cancelReason      OrderCancelReason? @map("cancel_reason")
  cancelledAt       DateTime?          @map("cancelled_at")
  /// Present if and only if cancelled after payment. Check `order_cancel_cause_check`.
  cancelCause       OrderCancelCause?  @map("cancel_cause")
  /// Internal note at cancel; required when the refund is below the refundable amount. Hidden from customers.
  cancelNote        String?            @map("cancel_note")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  /// Guests: the privacy policy version agreed to at checkout. Check constraint: set when there is no `customerId`.
  privacyPolicyVersionId String?             @map("privacy_policy_version_id") @db.Uuid
  privacyPolicyVersion   ContentPageVersion? @relation(fields: [privacyPolicyVersionId], references: [id], onDelete: Restrict)

  /// Company invoice, snapshotted at checkout. Check constraint: all three or none.
  invoiceCompanyName String? @map("invoice_company_name")
  invoiceTaxCode     String? @map("invoice_tax_code")
  invoiceAddress     String? @map("invoice_address")

  /// Handover. Check constraint `order_handover_check`: all three present if and only if fulfillment reached
  /// `handed_over` (`delivered`, `failed` included).
  carrier             String?
  trackingNumber      String?           @map("tracking_number")
  handedOverAt        DateTime?         @map("handed_over_at")
  kind                OrderKind         @default(standard)
  /// The pre-order's campaign; empty for in-stock orders. Check `order_preorder_check`: pre-orders have the campaign
  /// and every deposit field below, in-stock orders none of them.
  preorderCampaignId  String?           @map("preorder_campaign_id") @db.Uuid
  preorderCampaign    PreorderCampaign? @relation(fields: [preorderCampaignId], references: [id], onDelete: Restrict)
  /// Snapshotted from the campaign: deposit percent, and deposit VND (rounded up to 1,000, on goods after discount,
  /// check `0 < deposit_amount <= subtotal - discount`).
  depositPercent      Int?              @map("deposit_percent")
  depositAmount       BigInt?           @map("deposit_amount")
  /// The voucher used, with values snapshotted at checkout (check `order_voucher_check`: with a voucher all are set,
  /// without one none are and `discount = 0`). Later edits or disabling do not change the order.
  voucherId           String?           @map("voucher_id") @db.Uuid
  voucher             Voucher?          @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  voucherCode         String?           @map("voucher_code")
  voucherKind         VoucherKind?      @map("voucher_kind")
  voucherAmount       BigInt?           @map("voucher_amount")
  voucherPercent      Int?              @map("voucher_percent")
  voucherMaxDiscount  BigInt?           @map("voucher_max_discount")
  /// Discount VND, taken off goods; check `0 <= discount <= subtotal`.
  discount            BigInt            @default(0)
  /// Expected delivery at order time; the campaign may change later (ticket 09) but the order keeps its promise.
  deliveryFrom        DateTime?         @map("delivery_from") @db.Date
  deliveryTo          DateTime?         @map("delivery_to") @db.Date
  /// Days to pay the remainder after arrival, snapshotted from the campaign.
  remainderDays       Int?              @map("remainder_days")
  /// When the deposit was paid (or restored by reconciliation); arrival allocation order (ADR 0013). Check
  /// `order_deposit_paid_check`.
  depositPaidAt       DateTime?         @map("deposit_paid_at")
  /// When every unit of the pre-order was reserved from arrivals (GLOSSARY "Hàng đã về"); the remainder deadline counts
  /// from here (`remainder_days` days). Check `order_arrival_check`.
  arrivedAt           DateTime?         @map("arrived_at")
  remainderDueAt      DateTime?         @map("remainder_due_at")
  /// When the remainder reminder was emailed (once, with ≤ 2 days left). Check `order_remainder_deadline_check`.
  remainderRemindedAt DateTime?         @map("remainder_reminded_at")
  /// When flagged as remainder overdue; cleared when fully paid. No cancel, no forfeited deposit (M6).
  remainderOverdueAt  DateTime?         @map("remainder_overdue_at")

  lines               OrderLine[]
  stockMovements      StockMovement[]
  policyVersions      OrderPolicyVersion[]
  events              OrderEvent[]
  lookupTokens        OrderLookupToken[]
  paymentLinks        PaymentLink[]
  paymentTransactions PaymentTransaction[]
  reconciliationItems ReconciliationItem[]
  refunds             Refund[]
  supportRequests     SupportRequest[]

  @@index([customerId])
  @@index([status, reservedUntil])
  @@index([createdAt])
  @@index([privacyPolicyVersionId])
  @@index([email, status])
  @@index([phone, status])
  @@index([preorderCampaignId])
  @@index([depositPaidAt])
  @@index([voucherId])
  @@map("order")
}

/// Order line: a snapshot of the variant at checkout.
model OrderLine {
  id                 String         @id @default(uuid()) @db.Uuid
  orderId            String         @map("order_id") @db.Uuid
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Position in the cart, from 0.
  position           Int
  variantId          String         @map("variant_id") @db.Uuid
  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sku                String
  productName        String         @map("product_name")
  attributes         Json
  /// Thumbnail: `StoredImage` (api/src/media/images.ts) with `alt`; `null` when none.
  image              Json?
  /// VND, sale price at checkout.
  price              BigInt
  /// 1–5 (check constraint).
  quantity           Int
  /// Units reserved in stock for this line, 0–`quantity` (check constraint). In-stock orders: `quantity` from
  /// reservation until cancel or handover; pre-orders: grows with receipts (ADR 0013). Cancel and handover reset it to
  /// 0.
  reservedQuantity   Int            @default(0) @map("reserved_quantity")
  /// Latest return to stock: units restocked and lost/damaged (M6a). Redelivery from stock resets them to 0.
  returnedQuantity   Int            @default(0) @map("returned_quantity")
  writtenOffQuantity Int            @default(0) @map("written_off_quantity")
  /// The order discount's share for this line, VND; 0 up to the line's goods (check constraint).
  discount           BigInt         @default(0)

  supportLines SupportRequestLine[]

  @@unique([orderId, position])
  @@index([variantId])
  @@map("order_line")
}

/// Policy page versions (returns, warranty) linked to the order's products at checkout.
model OrderPolicyVersion {
  orderId       String             @map("order_id") @db.Uuid
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  pageVersionId String             @map("page_version_id") @db.Uuid
  pageVersion   ContentPageVersion @relation(fields: [pageVersionId], references: [id], onDelete: Restrict)

  @@id([orderId, pageVersionId])
  @@index([pageVersionId])
  @@map("order_policy_version")
}

/// Order action history. Append-only: migration triggers block UPDATE, DELETE and TRUNCATE.
model OrderEvent {
  id         String          @id @default(uuid()) @db.Uuid
  seq        BigInt          @unique @default(autoincrement())
  orderId    String          @map("order_id") @db.Uuid
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Event kind, see `OrderEventKind` (api/src/orders/orders.ts).
  kind       String
  actor      OrderEventActor
  /// Set exactly when `actor = staff` (check constraint).
  staffId    String?         @map("staff_id") @db.Uuid
  staff      Staff?          @relation(fields: [staffId], references: [id], onDelete: Restrict)
  /// Only when `actor = customer` and signed in; customers using a lookup token give `null`.
  customerId String?         @map("customer_id") @db.Uuid
  customer   Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  data       Json            @default("{}")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([orderId, seq])
  @@map("order_event")
}

/// Extra lookup tokens for an order, e.g. for email links; the checkout token is `Order.lookupTokenHash`.
model OrderLookupToken {
  /// SHA-256 of the token, hex.
  tokenHash String   @id @map("token_hash")
  orderId   String   @map("order_id") @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_lookup_token")
}

/// How a payment was reported: gateway webhook, a query when the customer returns, or the simulator button.
enum PaymentSource {
  webhook
  query
  simulator
  /// Signed params VNPAY sends along when returning the customer to the result page (ADR 0010).
  return

  @@map("payment_source")
}

/// What a payment link (and transactions arriving through it) collects.
enum PaymentPurpose {
  /// Full payment of an in-stock order at once.
  full
  /// Pre-order deposit (M4).
  deposit
  /// Pre-order remaining balance (M4).
  remainder

  @@map("payment_purpose")
}

/// One gateway payment link created for an order. An order can have several (deposit, then remainder).
model PaymentLink {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @map("order_id") @db.Uuid
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  purpose          PaymentPurpose
  /// VND, > 0: the amount the link asks for.
  amount           BigInt
  /// Gateway reference (VNPAY `vnp_TxnRef`) returned on link creation; used for queries and recording (ADR 0010).
  gatewayReference String         @unique @map("gateway_reference")
  createdAt        DateTime       @default(now()) @map("created_at")
  expiresAt        DateTime       @map("expires_at")

  @@index([orderId, createdAt])
  @@map("payment_link")
}

/// A payment the gateway reported for an order. Append-only: migration triggers block UPDATE, DELETE and TRUNCATE.
model PaymentTransaction {
  id        String         @id @default(uuid()) @db.Uuid
  orderId   String         @map("order_id") @db.Uuid
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// From the link the transaction came through; no matching link (old order, unknown ref) means `full`.
  purpose   PaymentPurpose
  /// VND, > 0.
  amount    BigInt
  /// Gateway transaction reference; unique so a payment is never recorded twice.
  reference String         @unique
  paidAt    DateTime       @map("paid_at")
  source    PaymentSource
  /// Raw gateway data, for later matching.
  payload   Json
  createdAt DateTime       @default(now()) @map("created_at")

  reconciliationItem ReconciliationItem?
  refunds            Refund[]

  @@index([orderId])
  @@map("payment_transaction")
}

/// Why a payment needs reconciliation.
enum ReconciliationReason {
  amount_mismatch
  paid_after_cancel
  extra_payment

  @@map("reconciliation_reason")
}

enum ReconciliationStatus {
  open
  resolved

  @@map("reconciliation_status")
}

enum ReconciliationResolution {
  restored
  handled_externally
  /// The system closed a mismatch item when a later payment made the order whole; no `resolvedBy`.
  settled_by_payment
  /// Accounting created a refund for the item amount (M6a).
  refunded

  @@map("reconciliation_resolution")
}

/// Where a refund came from: cancelling a paid order, resolving a reconciliation item, or recreating a failed refund.
enum RefundOrigin {
  cancellation
  reconciliation
  retry
  /// A return after delivery (M6b): has `supportRequestId`.
  return

  @@map("refund_origin")
}

/// `pending` awaiting accounting → `processing` (gateway processing) → `succeeded` or `failed`. Manual refunds go
/// straight from `pending` to `succeeded`.
enum RefundStatus {
  pending
  processing
  succeeded
  failed

  @@map("refund_status")
}

enum RefundMethod {
  vnpay
  manual

  @@map("refund_method")
}

/// Refund (GLOSSARY "Hoàn tiền", ADR 0014): money returned to a customer for an order, tracked until it resolves. Non-
/// `failed` refunds of an order never exceed what was received (checked under the order lock in `payments/refunds.ts`).
model Refund {
  id                   String              @id @default(uuid()) @db.Uuid
  orderId              String              @map("order_id") @db.Uuid
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// VND, > 0.
  amount               BigInt
  origin               RefundOrigin
  /// Present if and only if `origin = reconciliation`.
  reconciliationItemId String?             @unique @map("reconciliation_item_id") @db.Uuid
  reconciliationItem   ReconciliationItem? @relation(fields: [reconciliationItemId], references: [id], onDelete: Restrict)
  /// Present if and only if `origin = retry`: the failed refund recreated; each failed refund can be recreated once.
  /// Present if and only if `origin = return` (M6b).
  supportRequestId     String?             @map("support_request_id") @db.Uuid
  supportRequest       SupportRequest?     @relation(fields: [supportRequestId], references: [id], onDelete: Restrict)
  retryOfId            String?             @unique @map("retry_of_id") @db.Uuid
  retryOf              Refund?             @relation("RefundRetry", fields: [retryOfId], references: [id], onDelete: Restrict)
  retriedBy            Refund?             @relation("RefundRetry")
  status               RefundStatus        @default(pending)
  /// Empty if and only if `pending`.
  method               RefundMethod?
  /// The original transaction; present if and only if `method = vnpay`.
  paymentTransactionId String?             @map("payment_transaction_id") @db.Uuid
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  /// Bank transaction ref and date of a manual refund; the customer's account number is never stored.
  bankReference        String?             @map("bank_reference")
  transferredOn        DateTime?           @map("transferred_on") @db.Date
  /// Internal note: reason at creation, notes at execution or settlement. Hidden from customers.
  note                 String?
  /// Data the gateway returned for a gateway refund.
  gatewayPayload       Json?               @map("gateway_payload")
  createdById          String              @map("created_by_id") @db.Uuid
  createdBy            Staff               @relation("RefundCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  executedById         String?             @map("executed_by_id") @db.Uuid
  executedBy           Staff?              @relation("RefundExecutedBy", fields: [executedById], references: [id], onDelete: Restrict)
  executedAt           DateTime?           @map("executed_at")
  /// Who settled a `processing` refund by hand after checking the gateway.
  settledById          String?             @map("settled_by_id") @db.Uuid
  settledBy            Staff?              @relation("RefundSettledBy", fields: [settledById], references: [id], onDelete: Restrict)
  completedAt          DateTime?           @map("completed_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([status])
  @@index([paymentTransactionId])
  @@map("refund")
}

/// Reconciliation item (GLOSSARY "Cần đối soát"): a payment not matching the order, awaiting accounting.
model ReconciliationItem {
  id            String                    @id @default(uuid()) @db.Uuid
  orderId       String                    @map("order_id") @db.Uuid
  order         Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactionId String                    @unique @map("transaction_id") @db.Uuid
  transaction   PaymentTransaction        @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  reason        ReconciliationReason
  /// VND of this payment.
  amount        BigInt
  receivedAt    DateTime                  @map("received_at")
  status        ReconciliationStatus      @default(open)
  /// How the item closed; present if and only if `status = resolved`.
  resolution    ReconciliationResolution?
  /// Required for `handled_externally`: amount, bank transaction ref.
  note          String?
  resolvedById  String?                   @map("resolved_by_id") @db.Uuid
  resolvedBy    Staff?                    @relation(fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt    DateTime?                 @map("resolved_at")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  /// The refund created when the item was resolved as `refunded`.
  refund        Refund?

  @@index([orderId])
  @@index([status, createdAt])
  @@map("reconciliation_item")
}

/// Supply status of a pre-order campaign, updated by staff. "Arrived" is not here: it is tracked per order.
enum PreorderSupplyStatus {
  not_ordered
  ordered
  in_transit
  issue

  @@map("preorder_supply_status")
}

/// Pre-order campaign (GLOSSARY "Đợt đặt trước"): one round of taking deposits for a product. Open while `closed_at`
/// is empty and `closes_at` has not passed; at most one open campaign per product (checked on create, product row
/// lock).
model PreorderCampaign {
  id             String               @id @default(uuid()) @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  product        Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Percentage of goods deposited; check 10–100.
  depositPercent Int                  @map("deposit_percent")
  /// Expected delivery dates; check `delivery_from <= delivery_to`.
  deliveryFrom   DateTime             @map("delivery_from") @db.Date
  deliveryTo     DateTime             @map("delivery_to") @db.Date
  /// Closing time for pre-orders.
  closesAt       DateTime             @map("closes_at")
  /// Days to pay the remainder after arrival; check >= 1.
  remainderDays  Int                  @default(7) @map("remainder_days")
  supplyStatus   PreorderSupplyStatus @default(not_ordered) @map("supply_status")
  /// Internal supply progress note, hidden from customers.
  supplyNote     String               @default("") @map("supply_note")
  /// Set when staff close it by hand; cannot reopen.
  closedAt       DateTime?            @map("closed_at")
  createdById    String               @map("created_by_id") @db.Uuid
  createdBy      Staff                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  variants PreorderCampaignVariant[]
  orders   Order[]

  @@index([productId, closesAt])
  @@index([createdAt])
  @@map("preorder_campaign")
}

/// A variant open in the campaign, with its allocation (GLOSSARY "Suất"); check `allocation >= 1`.
model PreorderCampaignVariant {
  campaignId String           @map("campaign_id") @db.Uuid
  campaign   PreorderCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  variantId  String           @map("variant_id") @db.Uuid
  variant    ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  allocation Int

  @@id([campaignId, variantId])
  @@index([variantId])
  @@map("preorder_campaign_variant")
}

enum VoucherKind {
  fixed
  percent

  @@map("voucher_kind")
}

/// Voucher (GLOSSARY "Mã giảm giá"). Never deleted, only disabled. Uses are counted from uncancelled orders, not
/// stored.
model Voucher {
  id               String      @id @default(uuid()) @db.Uuid
  /// Uppercase letters and digits, 4–20 characters; check `voucher_code_check`.
  code             String      @unique
  description      String      @default("")
  kind             VoucherKind
  /// Check `voucher_kind_check`: `fixed` has `amount` (VND); `percent` has `percent` (1–50) and `max_discount` (VND).
  amount           BigInt?
  percent          Int?
  maxDiscount      BigInt?     @map("max_discount")
  minSubtotal      BigInt      @default(0) @map("min_subtotal")
  startsAt         DateTime    @map("starts_at")
  /// Check `ends_at > starts_at`.
  endsAt           DateTime    @map("ends_at")
  /// Sale types it applies to; at least one.
  saleTypes        OrderKind[] @map("sale_types")
  /// Empty means unlimited.
  totalLimit       Int?        @map("total_limit")
  perCustomerLimit Int         @default(1) @map("per_customer_limit")
  disabledAt       DateTime?   @map("disabled_at")
  createdById      String      @map("created_by_id") @db.Uuid
  createdBy        Staff       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  brands     VoucherBrand[]
  categories VoucherCategory[]
  orders     Order[]

  @@index([createdAt])
  @@map("voucher")
}

/// Brand scope; a voucher without rows covers every brand.
model VoucherBrand {
  voucherId String  @map("voucher_id") @db.Uuid
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  brandId   String  @map("brand_id") @db.Uuid
  brand     Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@id([voucherId, brandId])
  @@index([brandId])
  @@map("voucher_brand")
}

/// Category scope, descendants included; a voucher without rows covers every category.
model VoucherCategory {
  voucherId  String   @map("voucher_id") @db.Uuid
  voucher    Voucher  @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([voucherId, categoryId])
  @@index([categoryId])
  @@map("voucher_category")
}

/// Support request type (GLOSSARY "Yêu cầu hỗ trợ"); every type except `other` is tied to an order.
enum SupportRequestKind {
  cancel
  return
  exchange
  warranty
  other

  @@map("support_request_kind")
}

/// `new` → `in_progress` ⇄ `waiting_customer` → `resolved` or `rejected` (final, never reopened).
enum SupportRequestStatus {
  new
  in_progress
  waiting_customer
  resolved
  rejected

  @@map("support_request_status")
}

/// Who wrote a message or created a request: customer, staff, or system (e.g. when the order was cancelled).
enum SupportAuthor {
  customer
  staff
  system
  /// Created by the chatbot when the customer confirms a handoff (M8); the first message is still the customer's.
  chatbot

  @@map("support_author")
}

/// Support request (spec M6b). Return, exchange and warranty parts are columns added by later tickets.
model SupportRequest {
  id                           String               @id @default(uuid()) @db.Uuid
  /// The code customers see (`#YC1001`); its own sequence.
  code                         Int                  @unique @default(dbgenerated("nextval('support_request_code_seq'::regclass)"))
  kind                         SupportRequestKind
  status                       SupportRequestStatus @default(new)
  subject                      String
  /// Required for every type except `other`. Check `support_request_order_check`.
  orderId                      String?              @map("order_id") @db.Uuid
  order                        Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// The customer account that can follow the request; with an order, the order's account (if any).
  customerId                   String?              @map("customer_id") @db.Uuid
  customer                     Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Where customer emails go: the order's email, or the account's.
  contactEmail                 String               @map("contact_email")
  contactName                  String?              @map("contact_name")
  assigneeId                   String?              @map("assignee_id") @db.Uuid
  assignee                     Staff?               @relation("SupportAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy                    SupportAuthor        @map("created_by")
  createdByStaffId             String?              @map("created_by_staff_id") @db.Uuid
  createdByStaff               Staff?               @relation("SupportCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  /// The earlier request the customer follows up (finished requests never reopen).
  previousRequestId            String?              @map("previous_request_id") @db.Uuid
  previousRequest              SupportRequest?      @relation("SupportFollowUp", fields: [previousRequestId], references: [id], onDelete: Restrict)
  followUps                    SupportRequest[]     @relation("SupportFollowUp")
  createdAt                    DateTime             @default(now()) @map("created_at")
  updatedAt                    DateTime             @updatedAt @map("updated_at")
  /// Present if and only if `resolved` or `rejected`.
  resolvedAt                   DateTime?            @map("resolved_at")
  /// Accept or reject (return, exchange, warranty), with who and when. Check `support_request_decision_check`.
  decision                     SupportDecision?
  decidedById                  String?              @map("decided_by_id") @db.Uuid
  decidedBy                    Staff?               @relation("SupportDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt                    DateTime?            @map("decided_at")
  /// The warehouse received the goods the customer sent; only after acceptance.
  receivedAt                   DateTime?            @map("received_at")
  receivedById                 String?              @map("received_by_id") @db.Uuid
  receivedBy                   Staff?               @relation("SupportReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  /// Return window snapshotted when a return or exchange is submitted: days, delivery time, days late (GLOSSARY "Hạn
  /// đổi trả").
  returnWindowDays             Int?                 @map("return_window_days")
  deliveredAt                  DateTime?            @map("delivered_at")
  overdueDays                  Int?                 @map("overdue_days")
  /// Exchange shipment (ADR 0015): all three fields or none; only after the old item arrived.
  exchangeCarrier              String?              @map("exchange_carrier")
  exchangeTrackingNumber       String?              @map("exchange_tracking_number")
  exchangeHandedOverAt         DateTime?            @map("exchange_handed_over_at")
  /// An accepted exchange with the old item not received after 14 days: flagged by a job, never auto-cancelled.
  exchangeOverdueAt            DateTime?            @map("exchange_overdue_at")
  /// Warranty: received → sent to the brand or repaired → returned, and the outcome. Check
  /// `support_request_warranty_check`.
  warrantyReceivedAt           DateTime?            @map("warranty_received_at")
  warrantySentAt               DateTime?            @map("warranty_sent_at")
  warrantyReturnedAt           DateTime?            @map("warranty_returned_at")
  warrantyReturnCarrier        String?              @map("warranty_return_carrier")
  warrantyReturnTrackingNumber String?              @map("warranty_return_tracking_number")
  warrantyOutcome              WarrantyOutcome?     @map("warranty_outcome")
  /// Message to the customer with the outcome; required when rejecting.
  warrantyOutcomeNote          String?              @map("warranty_outcome_note")

  messages         SupportMessage[]
  attachments      SupportAttachment[]
  lines            SupportRequestLine[]
  /// Follow link for requests without an order or account (guests handed off by the chatbot).
  tokens           SupportRequestToken[]
  /// The chatbot conversation that became this request (M8).
  chatConversation ChatConversation?
  stockMovements   StockMovement[]
  refunds          Refund[]

  @@index([orderId])
  @@index([customerId])
  @@index([status, createdAt])
  @@index([assigneeId])
  @@map("support_request")
}

/// Warranty outcome: repaired, replaced (creates a follow-up exchange), rejected, refunded (creates a follow-up
/// return).
enum WarrantyOutcome {
  repaired
  replaced
  rejected
  refunded

  @@map("warranty_outcome")
}

/// A support request message; append-only. `internal`: an internal note, hidden from customers.
model SupportMessage {
  id        String         @id @default(uuid()) @db.Uuid
  requestId String         @map("request_id") @db.Uuid
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  author    SupportAuthor
  staffId   String?        @map("staff_id") @db.Uuid
  staff     Staff?         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  internal  Boolean        @default(false)
  body      String
  createdAt DateTime       @default(now()) @map("created_at")

  attachments SupportAttachment[]

  @@index([requestId, createdAt])
  @@map("support_message")
}

/// An image attached to a support message (spec M6b): re-encoded (EXIF stripped), in the `private` bucket under `key`.
model SupportAttachment {
  id          String         @id @default(uuid()) @db.Uuid
  requestId   String         @map("request_id") @db.Uuid
  request     SupportRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  messageId   String         @map("message_id") @db.Uuid
  message     SupportMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  key         String         @unique
  contentType String         @map("content_type")
  sizeBytes   Int            @map("size_bytes")
  width       Int
  height      Int
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([requestId])
  @@index([messageId])
  @@map("support_attachment")
}

/// Return reason chosen by the customer.
enum SupportReturnReason {
  defective
  wrong_fit
  not_as_described
  other

  @@map("support_return_reason")
}

/// Staff accept or reject a return, exchange or warranty request.
enum SupportDecision {
  accepted
  rejected

  @@map("support_decision")
}

/// An order line in a return (exchange, warranty) request: quantity, reason, and the warehouse receiving result.
model SupportRequestLine {
  id                 String               @id @default(uuid()) @db.Uuid
  requestId          String               @map("request_id") @db.Uuid
  request            SupportRequest       @relation(fields: [requestId], references: [id], onDelete: Restrict)
  orderLineId        String               @map("order_line_id") @db.Uuid
  orderLine          OrderLine            @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  quantity           Int
  reason             SupportReturnReason?
  /// Receiving result: units restocked and written off; together at most `quantity` (check).
  restockedQuantity  Int                  @default(0) @map("restocked_quantity")
  writtenOffQuantity Int                  @default(0) @map("written_off_quantity")
  /// The variant the warehouse actually received (the variant the customer holds for the line).
  /// The variant held at submit (latest delivered exchange, or the original); the warehouse receives exactly this one.
  heldVariantId      String               @map("held_variant_id") @db.Uuid
  heldVariant        ProductVariant       @relation("SupportLineHeld", fields: [heldVariantId], references: [id], onDelete: Restrict)
  /// Exchange: the variant the customer gets (same product, same price; ADR 0015) and the quantity reserved for it.
  exchangeVariantId  String?              @map("exchange_variant_id") @db.Uuid
  exchangeVariant    ProductVariant?      @relation("SupportLineExchange", fields: [exchangeVariantId], references: [id], onDelete: Restrict)
  reservedQuantity   Int                  @default(0) @map("reserved_quantity")
  receivedVariantId  String?              @map("received_variant_id") @db.Uuid
  receivedVariant    ProductVariant?      @relation("SupportLineReceived", fields: [receivedVariantId], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now()) @map("created_at")

  @@unique([requestId, orderLineId])
  @@index([orderLineId])
  @@map("support_request_line")
}

/// Return window per product type (GLOSSARY "Hạn đổi trả"): days from delivery; only warns staff.
model ReturnWindow {
  productType ProductType @id @map("product_type")
  days        Int
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("return_window")
}

/// Chatbot settings (M8), at most one row (check `id`). No row means defaults: off, no response-time sentence.
model ChatbotSetting {
  id               Boolean  @id @default(true)
  enabled          Boolean  @default(false)
  /// Sentence the owner writes, read to customers on handoff. Empty means none.
  responseTimeNote String   @default("") @map("response_time_note")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("chatbot_setting")
}

enum ChatRole {
  customer
  assistant

  @@map("chat_role")
}

/// A customer's chatbot conversation (GLOSSARY "Chatbot"). After 24 h of silence the next message opens a new one;
/// after 90 days the cleanup job deletes it.
model ChatConversation {
  id                   String          @id @default(uuid()) @db.Uuid
  /// The customer's IP at start, hashed: to match abuse, without revealing the original IP.
  ipHash               String          @map("ip_hash")
  /// Customer message count, to block over 30 per conversation without recounting.
  customerMessageCount Int             @default(0) @map("customer_message_count")
  createdAt            DateTime        @default(now()) @map("created_at")
  lastMessageAt        DateTime        @default(now()) @map("last_message_at")
  /// The support request created when the customer confirms a handoff; once per conversation. When set, cleanup keeps
  /// it.
  supportRequestId     String?         @unique @map("support_request_id") @db.Uuid
  supportRequest       SupportRequest? @relation(fields: [supportRequestId], references: [id], onDelete: Restrict)
  messages             ChatMessage[]

  @@index([lastMessageAt])
  @@map("chat_conversation")
}

/// A conversation message. An unanswered turn puts `error` on the customer's message and has no chatbot message.
model ChatMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String
  /// Chatbot message: the answering model (`provider:model`) and the system prompt version.
  model          String?
  promptVersion  Int?             @map("prompt_version")
  /// Customer message: `exhausted` (every model out of quota) or `failed` (error) when that turn had no answer.
  error          String?
  /// Chatbot message: suggested products (`[{ slug, name }]`), and the summary when it offers a handoff.
  products       Json             @default("[]")
  handoffSummary String?          @map("handoff_summary")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([createdAt])
  @@map("chat_message")
}

/// Model calls per day (Vietnam time) and model, for reports; never used to block (ADR 0017: providers block
/// themselves).
model ChatUsageDay {
  day          DateTime @db.Date
  /// `provider:model`.
  model        String
  calls        Int      @default(0)
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  /// Times the model returned 429, and other errors (5xx, timeout, broken reply).
  rateLimited  Int      @default(0) @map("rate_limited")
  errors       Int      @default(0)

  @@id([day, model])
  @@map("chat_usage_day")
}

/// Token in the email link of a request without an order or account (M8); one per email, like `order_lookup_token`.
model SupportRequestToken {
  /// SHA-256 of the token, hex.
  tokenHash String         @id @map("token_hash")
  requestId String         @map("request_id") @db.Uuid
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([requestId])
  @@map("support_request_token")
}
