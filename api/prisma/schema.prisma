generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Miền xác thực, cũng là audience của JWT (ADR 0001).
enum AuthAudience {
  staff
  customer

  @@map("auth_audience")
}

/// Role cố định; tập permission của mỗi role định nghĩa trong code.
enum StaffRole {
  owner
  sales
  warehouse
  accountant

  @@map("staff_role")
}

/// Nhân viên. Không có đăng ký; owner đầu tiên tạo bằng lệnh seed.
model Staff {
  id           String      @id @default(uuid()) @db.Uuid
  /// Luôn lưu dạng chữ thường.
  email        String      @unique
  name         String
  /// argon2id, dạng chuỗi PHC.
  passwordHash String      @map("password_hash")
  roles        StaffRole[] @default([])
  /// Có giá trị nghĩa là tài khoản bị khóa.
  lockedAt     DateTime?   @map("locked_at")
  /// Chỗ sẵn cho 2FA (TOTP), chưa bật.
  totpSecret   String?     @map("totp_secret")
  totpEnabled  Boolean     @default(false) @map("totp_enabled")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  auditLogs         AuditLog[]
  publishedVersions ContentPageVersion[]

  @@map("staff")
}

/// Append-only: trigger trong migration chặn UPDATE, DELETE và TRUNCATE.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// Thứ tự ghi, để sắp xếp ổn định khi nhiều bản ghi trùng thời điểm.
  seq        BigInt   @unique @default(autoincrement())
  actorId    String   @map("actor_id") @db.Uuid
  actor      Staff    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// Ví dụ `staff.create`, `staff.roles.change`.
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, createdAt])
  @@map("audit_log")
}

/// Refresh token của mọi miền. Chỉ lưu hash; các token sinh ra từ một lần đăng nhập chung một family.
model RefreshToken {
  id        String       @id @default(uuid()) @db.Uuid
  audience  AuthAudience
  subjectId String       @map("subject_id") @db.Uuid
  familyId  String       @map("family_id") @db.Uuid
  /// SHA-256 của token, hex.
  tokenHash String       @unique @map("token_hash")
  /// Hạn tuyệt đối của cả phiên: token mới khi rotation kế thừa hạn của token cũ.
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  revokedAt DateTime?    @map("revoked_at")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([audience, subjectId])
  @@index([familyId])
  @@map("refresh_token")
}

/// Khách tự đăng ký; tách hẳn khỏi `staff` (ADR 0001), nên có thể trùng email với một nhân viên.
model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  /// Luôn lưu dạng chữ thường.
  email           String    @unique
  /// argon2id, dạng chuỗi PHC.
  passwordHash    String    @map("password_hash")
  /// Chưa xác minh không chặn việc dùng tài khoản.
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  consents CustomerConsent[]
  tokens   CustomerToken[]

  @@map("customer")
}

/// Append-only: khách đồng ý với đúng phiên bản chính sách bảo mật nào, vào lúc nào.
model CustomerConsent {
  id              String             @id @default(uuid()) @db.Uuid
  customerId      String             @map("customer_id") @db.Uuid
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  policyVersionId String             @map("policy_version_id") @db.Uuid
  policyVersion   ContentPageVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  consentedAt     DateTime           @default(now()) @map("consented_at")

  @@index([customerId])
  @@map("customer_consent")
}

/// Mục đích của token một lần gửi qua email. Ticket 06 thêm đặt lại mật khẩu.
enum CustomerTokenPurpose {
  email_verification

  @@map("customer_token_purpose")
}

/// Token một lần, có hạn, gửi qua email. Chỉ lưu hash.
model CustomerToken {
  id         String               @id @default(uuid()) @db.Uuid
  customerId String               @map("customer_id") @db.Uuid
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  purpose    CustomerTokenPurpose
  /// SHA-256 của token, hex.
  tokenHash  String               @unique @map("token_hash")
  expiresAt  DateTime             @map("expires_at")
  usedAt     DateTime?            @map("used_at")
  createdAt  DateTime             @default(now()) @map("created_at")

  @@index([customerId, purpose])
  @@map("customer_token")
}

enum ContentPageKind {
  about
  process
  policy

  @@map("content_page_kind")
}

/// Trang nội dung. `title`, `body` là bản đang soạn; khách chỉ thấy phiên bản đã xuất bản mới nhất.
model ContentPage {
  id        String          @id @default(uuid()) @db.Uuid
  /// Không đổi sau khi tạo, vì URL công khai và module khác tham chiếu theo slug.
  slug      String          @unique
  kind      ContentPageKind
  title     String
  /// Markdown.
  body      String
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  versions ContentPageVersion[]

  @@map("content_page")
}

/// Nội dung trang tại một lần xuất bản; không sửa, không xóa, để lời đồng ý và đơn hàng tham chiếu đúng nội dung lúc đó.
model ContentPageVersion {
  id            String      @id @default(uuid()) @db.Uuid
  pageId        String      @map("page_id") @db.Uuid
  page          ContentPage @relation(fields: [pageId], references: [id], onDelete: Restrict)
  /// Đánh số từ 1 trong từng trang.
  version       Int
  title         String
  body          String
  publishedAt   DateTime    @default(now()) @map("published_at")
  publishedById String      @map("published_by_id") @db.Uuid
  publishedBy   Staff       @relation(fields: [publishedById], references: [id], onDelete: Restrict)

  customerConsents CustomerConsent[]

  @@unique([pageId, version])
  @@map("content_page_version")
}

/// Năm nhóm hàng cố định, là gốc của cây danh mục; quyết định schema thuộc tính của sản phẩm.
enum ProductType {
  footwear
  apparel
  watch
  bag
  fragrance

  @@map("product_type")
}

/// Thương hiệu. Ẩn chỉ gỡ khỏi danh sách công khai và trang riêng, không ảnh hưởng sản phẩm.
model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String   @default("")
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("brand")
}

/// Nút trong cây danh mục, nằm trọn trong một nhóm hàng (ADR 0004). `parentId` null là con trực tiếp của nhóm hàng.
model Category {
  id          String      @id @default(uuid()) @db.Uuid
  /// Cố định từ lúc tạo; danh mục con luôn cùng nhóm hàng với cha.
  productType ProductType @map("product_type")
  parentId    String?     @map("parent_id") @db.Uuid
  parent      Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]  @relation("CategoryTree")
  slug        String      @unique
  name        String
  /// Ẩn danh mục thì cả nhánh con cũng không còn trong menu.
  hidden      Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("category")
}

/// Cấu hình hệ thống dạng khóa → giá trị JSON; schema của từng khóa định nghĩa trong `@ecommerce/shared`.
model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}
