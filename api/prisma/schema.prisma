generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Miền xác thực, cũng là audience của JWT (ADR 0001).
enum AuthAudience {
  staff
  customer

  @@map("auth_audience")
}

/// Role cố định; tập permission của mỗi role định nghĩa trong code.
enum StaffRole {
  owner
  sales
  warehouse
  accountant

  @@map("staff_role")
}

/// Nhân viên. Không có đăng ký; owner đầu tiên tạo bằng lệnh seed.
model Staff {
  id           String      @id @default(uuid()) @db.Uuid
  /// Luôn lưu dạng chữ thường.
  email        String      @unique
  name         String
  /// argon2id, dạng chuỗi PHC.
  passwordHash String      @map("password_hash")
  roles        StaffRole[] @default([])
  /// Có giá trị nghĩa là tài khoản bị khóa.
  lockedAt     DateTime?   @map("locked_at")
  /// Chỗ sẵn cho 2FA (TOTP), chưa bật.
  totpSecret   String?     @map("totp_secret")
  totpEnabled  Boolean     @default(false) @map("totp_enabled")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  auditLogs                AuditLog[]
  publishedVersions        ContentPageVersion[]
  publishedProductVersions ProductVersion[]

  @@map("staff")
}

/// Append-only: trigger trong migration chặn UPDATE, DELETE và TRUNCATE.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// Thứ tự ghi, để sắp xếp ổn định khi nhiều bản ghi trùng thời điểm.
  seq        BigInt   @unique @default(autoincrement())
  actorId    String   @map("actor_id") @db.Uuid
  actor      Staff    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// Ví dụ `staff.create`, `staff.roles.change`.
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, createdAt])
  @@map("audit_log")
}

/// Bộ đếm giới hạn tần suất theo cửa sổ cố định. `key` là SHA-256 của tên giới hạn kèm IP hoặc email.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime @map("window_start")
  hits        Int

  @@map("rate_limit_bucket")
}

/// Refresh token của mọi miền. Chỉ lưu hash; các token sinh ra từ một lần đăng nhập chung một family.
model RefreshToken {
  id        String       @id @default(uuid()) @db.Uuid
  audience  AuthAudience
  subjectId String       @map("subject_id") @db.Uuid
  familyId  String       @map("family_id") @db.Uuid
  /// SHA-256 của token, hex.
  tokenHash String       @unique @map("token_hash")
  /// Hạn tuyệt đối của cả phiên: token mới khi rotation kế thừa hạn của token cũ.
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  revokedAt DateTime?    @map("revoked_at")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([audience, subjectId])
  @@index([familyId])
  @@map("refresh_token")
}

/// Khách tự đăng ký; tách hẳn khỏi `staff` (ADR 0001), nên có thể trùng email với một nhân viên.
model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  /// Luôn lưu dạng chữ thường.
  email           String    @unique
  /// argon2id, dạng chuỗi PHC.
  passwordHash    String    @map("password_hash")
  /// Chưa xác minh không chặn việc dùng tài khoản.
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  consents CustomerConsent[]
  tokens   CustomerToken[]

  @@map("customer")
}

/// Append-only: khách đồng ý với đúng phiên bản chính sách bảo mật nào, vào lúc nào.
model CustomerConsent {
  id              String             @id @default(uuid()) @db.Uuid
  customerId      String             @map("customer_id") @db.Uuid
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  policyVersionId String             @map("policy_version_id") @db.Uuid
  policyVersion   ContentPageVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  consentedAt     DateTime           @default(now()) @map("consented_at")

  @@index([customerId])
  @@map("customer_consent")
}

/// Mục đích của token một lần gửi qua email. Ticket 06 thêm đặt lại mật khẩu.
enum CustomerTokenPurpose {
  email_verification
  password_reset

  @@map("customer_token_purpose")
}

/// Token một lần, có hạn, gửi qua email. Chỉ lưu hash.
model CustomerToken {
  id         String               @id @default(uuid()) @db.Uuid
  customerId String               @map("customer_id") @db.Uuid
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  purpose    CustomerTokenPurpose
  /// SHA-256 của token, hex.
  tokenHash  String               @unique @map("token_hash")
  expiresAt  DateTime             @map("expires_at")
  usedAt     DateTime?            @map("used_at")
  createdAt  DateTime             @default(now()) @map("created_at")

  @@index([customerId, purpose])
  @@map("customer_token")
}

enum ContentPageKind {
  about
  process
  policy

  @@map("content_page_kind")
}

/// Trang nội dung. `title`, `body` là bản đang soạn; khách chỉ thấy phiên bản đã xuất bản mới nhất.
model ContentPage {
  id        String          @id @default(uuid()) @db.Uuid
  /// Không đổi sau khi tạo, vì URL công khai và module khác tham chiếu theo slug.
  slug      String          @unique
  kind      ContentPageKind
  title     String
  /// Markdown.
  body      String
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  versions ContentPageVersion[]
  products ProductPolicyPage[]

  @@map("content_page")
}

/// Nội dung trang tại một lần xuất bản; không sửa, không xóa, để lời đồng ý và đơn hàng tham chiếu đúng nội dung lúc đó.
model ContentPageVersion {
  id            String      @id @default(uuid()) @db.Uuid
  pageId        String      @map("page_id") @db.Uuid
  page          ContentPage @relation(fields: [pageId], references: [id], onDelete: Restrict)
  /// Đánh số từ 1 trong từng trang.
  version       Int
  title         String
  body          String
  publishedAt   DateTime    @default(now()) @map("published_at")
  publishedById String      @map("published_by_id") @db.Uuid
  publishedBy   Staff       @relation(fields: [publishedById], references: [id], onDelete: Restrict)

  customerConsents CustomerConsent[]

  @@unique([pageId, version])
  @@map("content_page_version")
}

/// Năm nhóm hàng cố định, là gốc của cây danh mục; quyết định schema thuộc tính của sản phẩm.
enum ProductType {
  footwear
  apparel
  watch
  bag
  fragrance

  @@map("product_type")
}

/// Thương hiệu. Ẩn chỉ gỡ khỏi danh sách công khai và trang riêng, không ảnh hưởng sản phẩm.
model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String   @default("")
  hidden      Boolean  @default(false)
  /// Logo trên bucket public: `StoredImage` (api/src/media/images.ts), `null` khi chưa có.
  logo        Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products        Product[]
  productVersions ProductVersion[]

  @@map("brand")
}

/// Schema thuộc tính của một nhóm hàng; mọi danh mục trong nhóm hàng dùng chung.
model AttributeSchema {
  productType ProductType @id @map("product_type")
  /// Mảng `AttributeDefinition` (@ecommerce/shared), xếp theo thứ tự hiển thị.
  attributes  Json
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at")

  @@map("attribute_schema")
}

/// Nút trong cây danh mục, nằm trọn trong một nhóm hàng (ADR 0004). `parentId` null là con trực tiếp của nhóm hàng.
model Category {
  id          String      @id @default(uuid()) @db.Uuid
  /// Cố định từ lúc tạo; danh mục con luôn cùng nhóm hàng với cha.
  productType ProductType @map("product_type")
  parentId    String?     @map("parent_id") @db.Uuid
  parent      Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]  @relation("CategoryTree")
  slug        String      @unique
  name        String
  /// Ẩn danh mục thì cả nhánh con cũng không còn trong menu.
  hidden      Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  products        Product[]
  productVersions ProductVersion[]

  @@index([parentId])
  @@map("category")
}

/// Vòng đời sản phẩm; chỉ `published` hiện với khách, và khách chỉ đọc phiên bản đang xuất bản.
enum ProductStatus {
  draft
  published
  archived

  @@map("product_status")
}

enum VariantStatus {
  active
  discontinued

  @@map("variant_status")
}

/// Sản phẩm: một mẫu hàng của một thương hiệu. Không có trường bảo hành (ADR 0005).
model Product {
  id                 String          @id @default(uuid()) @db.Uuid
  /// Lấy từ danh mục lúc tạo và cố định; đổi danh mục chỉ trong cùng nhóm hàng.
  productType        ProductType     @map("product_type")
  brandId            String          @map("brand_id") @db.Uuid
  brand              Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId         String          @map("category_id") @db.Uuid
  category           Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug               String          @unique
  name               String
  /// Mã mẫu do hãng đặt; chuỗi rỗng khi chưa có.
  modelCode          String          @default("") @map("model_code")
  description        String          @default("")
  /// Hướng dẫn sử dụng và bảo quản.
  usageCare          String          @default("") @map("usage_care")
  /// `SizeChart` (@ecommerce/shared), `null` khi không có.
  sizeChart          Json?           @map("size_chart")
  /// Thông tin nguồn gốc công bố, không kèm bằng chứng.
  originStatement    String          @default("") @map("origin_statement")
  /// Thuộc tính cấp sản phẩm, đã kiểm theo schema của nhóm hàng.
  attributes         Json            @default("{}")
  groundShippingOnly Boolean         @default(false) @map("ground_shipping_only")
  status             ProductStatus   @default(draft)
  /// Phiên bản khách đang thấy; check constraint: có đúng khi `status = published`.
  liveVersionId      String?         @unique @map("live_version_id") @db.Uuid
  liveVersion        ProductVersion? @relation("LiveVersion", fields: [liveVersionId], references: [id], onDelete: Restrict)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  variants    ProductVariant[]
  images      ProductImage[]
  versions    ProductVersion[]    @relation("ProductVersions")
  policyPages ProductPolicyPage[]
  documents   ProductDocument[]
  commitments ProductCommitment[]

  @@index([productType])
  @@index([brandId])
  @@index([categoryId])
  @@map("product")
}

/// Biến thể khách mua. Migration có unique index `(product_id, attributes)` mà Prisma không khai báo được trên Json.
model ProductVariant {
  id             String        @id @default(uuid()) @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Duy nhất toàn hệ thống, lưu chữ hoa.
  sku            String        @unique
  /// Thuộc tính cấp biến thể, đã kiểm theo schema của nhóm hàng.
  attributes     Json          @default("{}")
  /// VND đã gồm VAT; `null` khi chưa đặt giá. Check constraint: `> 0`, giá hãng `>=` giá bán.
  price          BigInt?
  compareAtPrice BigInt?       @map("compare_at_price")
  status         VariantStatus @default(active)
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  images ProductImageVariant[]

  @@map("product_variant")
}

/// Nội dung sản phẩm tại một lần xuất bản; khách chỉ đọc từ đây. Không sửa, không xóa (trigger trong migration).
/// Các cột ngoài `snapshot` là bản chép từ snapshot để lọc và sắp xếp.
model ProductVersion {
  id                 String      @id @default(uuid()) @db.Uuid
  productId          String      @map("product_id") @db.Uuid
  product            Product     @relation("ProductVersions", fields: [productId], references: [id], onDelete: Restrict)
  /// Đánh số từ 1 trong từng sản phẩm.
  version            Int
  slug               String
  productType        ProductType @map("product_type")
  brandId            String      @map("brand_id") @db.Uuid
  brand              Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId         String      @map("category_id") @db.Uuid
  category           Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Giá thấp nhất trong các biến thể đang bán, và giá hãng của chính biến thể đó.
  fromPrice          BigInt      @map("from_price")
  fromCompareAtPrice BigInt?     @map("from_compare_at_price")
  /// `ProductSnapshot` (api/src/catalog/publication.ts).
  snapshot           Json
  publishedAt        DateTime    @default(now()) @map("published_at")
  publishedById      String      @map("published_by_id") @db.Uuid
  publishedBy        Staff       @relation(fields: [publishedById], references: [id], onDelete: Restrict)

  liveOf Product? @relation("LiveVersion")

  @@unique([productId, version])
  @@index([slug])
  @@index([brandId])
  @@index([categoryId])
  @@map("product_version")
}

/// Trang chính sách áp dụng cho sản phẩm; liên kết tới trang, không tới một phiên bản (GLOSSARY "Trang chính sách").
model ProductPolicyPage {
  productId String      @map("product_id") @db.Uuid
  product   Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  pageId    String      @map("page_id") @db.Uuid
  page      ContentPage @relation(fields: [pageId], references: [id], onDelete: Restrict)

  @@id([productId, pageId])
  @@index([pageId])
  @@map("product_policy_page")
}

/// Ảnh sản phẩm trên bucket public: bản gốc `<storageKey>/original.<đuôi>` và các cỡ webp `<storageKey>/w<cỡ>.webp`.
model ProductImage {
  id          String                @id @default(uuid()) @db.Uuid
  productId   String                @map("product_id") @db.Uuid
  product     Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  storageKey  String                @unique @map("storage_key")
  /// MIME type thật của bản gốc, đọc từ nội dung file.
  contentType String                @map("content_type")
  /// Kích thước bản gốc sau khi xoay theo EXIF.
  width       Int
  height      Int
  /// Các cỡ webp đã sinh, theo chiều rộng danh nghĩa.
  widths      Int[]
  alt         String                @default("")
  sortOrder   Int                   @default(0) @map("sort_order")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  variants    ProductImageVariant[]

  @@index([productId])
  @@map("product_image")
}

/// Ảnh gắn vào biến thể; API chỉ cho gắn biến thể của chính sản phẩm có ảnh.
model ProductImageVariant {
  imageId   String         @map("image_id") @db.Uuid
  image     ProductImage   @relation(fields: [imageId], references: [id], onDelete: Cascade)
  variantId String         @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([imageId, variantId])
  @@index([variantId])
  @@map("product_image_variant")
}

/// Chứng từ nguồn hàng nội bộ trên bucket private, key `products/<productId>/documents/<id>`. Không bao giờ công khai.
model ProductDocument {
  id          String                      @id @default(uuid()) @db.Uuid
  productId   String                      @map("product_id") @db.Uuid
  product     Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  storageKey  String                      @unique @map("storage_key")
  /// Tên file lúc tải lên, chỉ để nhân viên nhận ra chứng từ.
  fileName    String                      @map("file_name")
  /// MIME type thật, đọc từ nội dung file.
  contentType String                      @map("content_type")
  sizeBytes   Int                         @map("size_bytes")
  createdAt   DateTime                    @default(now()) @map("created_at")
  commitments ProductCommitmentDocument[]

  @@index([productId])
  @@map("product_document")
}

enum CommitmentKind {
  warranty
  other

  @@map("commitment_kind")
}

/// Loại cam kết: danh sách đóng, seed trong migration, chỉ `commitment.edit` thêm và sửa.
model CommitmentType {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String              @unique
  /// `warranty` là bảo hành; bảo hành chỉ hiện với khách qua loại này (ADR 0005).
  kind        CommitmentKind
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at")
  commitments ProductCommitment[]

  @@map("commitment_type")
}

/// Cam kết có bằng chứng ở cấp sản phẩm; mỗi loại tối đa một cam kết trên một sản phẩm.
model ProductCommitment {
  id        String                      @id @default(uuid()) @db.Uuid
  productId String                      @map("product_id") @db.Uuid
  product   Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  typeId    String                      @map("type_id") @db.Uuid
  type      CommitmentType              @relation(fields: [typeId], references: [id], onDelete: Restrict)
  /// Nội dung hiển thị cho khách.
  statement String
  createdAt DateTime                    @default(now()) @map("created_at")
  updatedAt DateTime                    @updatedAt @map("updated_at")
  documents ProductCommitmentDocument[]

  @@unique([productId, typeId])
  @@map("product_commitment")
}

/// Chứng từ làm bằng chứng cho cam kết; chứng từ đang được tham chiếu thì không xóa được.
model ProductCommitmentDocument {
  commitmentId String            @map("commitment_id") @db.Uuid
  commitment   ProductCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  documentId   String            @map("document_id") @db.Uuid
  document     ProductDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([commitmentId, documentId])
  @@index([documentId])
  @@map("product_commitment_document")
}

/// Cấu hình hệ thống dạng khóa → giá trị JSON; schema của từng khóa định nghĩa trong `@ecommerce/shared`.
model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}
